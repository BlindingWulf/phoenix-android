+
+// AcquireOAuthSession runs the management-configured SSO flow without
+// registering or re-registering the peer. It supports account API reauth for
+// an already-enrolled client.
+func (a *Auth) AcquireOAuthSession(listener OAuthSessionListener, urlOpener URLOpener, isAndroidTV bool) {
+	go func() {
+		if listener == nil {
+			return
+		}
+		authClient, err := auth.NewAuth(a.ctx, a.config.PrivateKey, a.config.ManagementURL, a.config)
+		if err != nil {
+			listener.OnOAuthSessionError(fmt.Errorf("failed to create auth client: %v", err))
+			return
+		}
+		defer authClient.Close()
+
+		flow, err := authClient.GetOAuthFlow(a.ctx, isAndroidTV, profileLoginHint(a.cfgPath))
+		if err != nil {
+			listener.OnOAuthSessionError(fmt.Errorf("failed to get OAuth flow: %v", err))
+			return
+		}
+		tokenInfo, err := runOAuthFlow(a.ctx, flow, urlOpener, nil)
+		if err != nil {
+			listener.OnOAuthSessionError(err)
+			return
+		}
+		deliverOAuthSession(listener, *tokenInfo, getOAuthTokenEndpoint(flow), flow.GetClientID(a.ctx))
+	}()
 }
 
