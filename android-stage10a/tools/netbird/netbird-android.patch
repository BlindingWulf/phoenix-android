+func TestParseOAuthTokenExpiresInUsesRemainingDuration(t *testing.T) {
+	flow := &PKCEAuthorizationFlow{providerConfig: PKCEAuthProviderConfig{
+		ClientID: "test-client",
+		Audience: "test-audience",
+	}}
+	claims := base64.RawURLEncoding.EncodeToString([]byte(`{"aud":"test-audience"}`))
+	token := &oauth2.Token{
+		AccessToken: "header." + claims + ".signature",
+		Expiry:      time.Now().Add(time.Hour),
+	}
+
+	info, err := flow.parseOAuthToken(token)
+	require.NoError(t, err)
+	require.InDelta(t, 3600, info.ExpiresIn, 1)
+}
